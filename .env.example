# Copy this file to .env and paste YOUR Maya Sandbox Public API Key.
# Get it from your Maya Business Manager / Developer Dashboard Sandbox credentials.
# Use the PUBLIC key (usually starts with pk-), not the Secret API Key.
MAYA_PUBLIC_KEY=pk-PASTE_YOUR_OWN_SANDBOX_PUBLIC_KEY_HERE
PORT=3000
BASE_URL=http://localhost:3000

# MySQL database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mensify_db
